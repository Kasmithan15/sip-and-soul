NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@127.0.0.1:5432/sipandsoul_local?schema=public
# At least 32 random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
FRONTEND_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Optional: email reset links automatically (https://resend.com). Without these, reset requests wait in the admin panel.
RESEND_API_KEY=
MAIL_FROM=Sip & Soul Café <no-reply@yourdomain.com>
